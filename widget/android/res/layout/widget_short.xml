<?xml version="1.0" encoding="utf-8"?>
<!-- Summary widget one row tall: the hero's name, value and trend on one line, and its line. The
     row has no room for the chart or the age, so the refresh control sits at the end of the
     hero's line wherever the placement is wide enough for both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/widget_padding"
  android:paddingEnd="@dimen/widget_padding"
  android:paddingTop="@dimen/widget_gap"
  android:paddingBottom="@dimen/widget_gap"
  android:background="@drawable/widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- The hero takes what the control leaves. Its row wraps its content, so the name, value and
         trend sit together until a long name or value fills the width; then the weights shrink
         the name's box and the value's, and each shrinks to fit. -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/sum_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom">

        <!-- The measure's key dot: the value stays in primary text, so its colour is said here. -->
        <ImageView
          android:id="@+id/sum_key"
          android:layout_width="6dp"
          android:layout_height="6dp"
          android:layout_gravity="center_vertical"
          android:layout_marginEnd="4dp"
          android:importantForAccessibility="no"
          android:src="@drawable/widget_tone_dot"
          android:visibility="gone" />

        <TextView
          android:fontFamily="@font/widget_manrope"
          android:id="@+id/sum_label"
          android:importantForAccessibility="no"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/widget_hero_line"
          android:layout_weight="1"
          android:layout_marginEnd="6dp"
          android:maxLines="2"
          android:hyphenationFrequency="normal"
          android:gravity="bottom"
          android:autoSizeTextType="uniform"
          android:autoSizeMinTextSize="@dimen/widget_text_floor"
          android:autoSizeMaxTextSize="@dimen/widget_text_value"
          android:autoSizeStepGranularity="1sp"
          android:textSize="@dimen/widget_text_value"
          android:textColor="@color/widget_text_secondary" />

        <TextView
          android:fontFamily="@font/widget_manrope"
          android:id="@+id/sum_value"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/widget_hero_line"
          android:layout_weight="1"
          android:maxLines="1"
          android:gravity="bottom"
          android:autoSizeTextType="uniform"
          android:autoSizeMinTextSize="@dimen/widget_text_floor"
          android:autoSizeMaxTextSize="@dimen/widget_text_hero"
          android:autoSizeStepGranularity="1sp"
          android:textSize="@dimen/widget_text_hero"
          android:textStyle="bold"
          android:textColor="@color/widget_text_primary" />

        <TextView
          android:fontFamily="@font/widget_manrope"
          android:id="@+id/sum_trend"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:textSize="@dimen/widget_text_label"
          android:textColor="@color/widget_text_secondary" />
      </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_refresh_control" />
  </LinearLayout>

  <TextView
    android:fontFamily="@font/widget_manrope"
    android:id="@+id/sum_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textStyle="bold"
    android:textColor="@color/widget_text_primary" />
</LinearLayout>
