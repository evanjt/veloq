<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/widget_padding"
  android:background="@drawable/widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/sum_label"
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textColor="@color/widget_text_secondary"
        android:textAllCaps="true"
        android:letterSpacing="0.05" />

      <LinearLayout
        android:id="@+id/sum_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
          android:id="@+id/sum_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="@dimen/widget_text_metric"
          android:textStyle="bold"
          android:textColor="@color/widget_text_primary" />

        <TextView
          android:id="@+id/sum_trend"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:textSize="@dimen/widget_text_label"
          android:textColor="@color/widget_trend_flat" />
      </LinearLayout>

      <TextView
        android:id="@+id/sum_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <ImageView
        android:id="@+id/sum_sparkline"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scaleType="fitXY" />

      <LinearLayout
        android:id="@+id/sum_chart_caption"
        android:importantForAccessibility="noHideDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- One series to a line, since two translated names side by side outgrow the column. -->
        <LinearLayout
          android:id="@+id/sum_series"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

          <TextView
            android:id="@+id/sum_series_fitness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/widget_legend_fitness"
            android:drawablePadding="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/widget_text_caption"
            android:textColor="@color/widget_text_secondary" />

          <TextView
            android:id="@+id/sum_series_fatigue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/widget_legend_fatigue"
            android:drawablePadding="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/widget_text_caption"
            android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <TextView
          android:id="@+id/sum_chart_span"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:ellipsize="end"
          android:textSize="@dimen/widget_text_caption"
          android:textColor="@color/widget_text_secondary" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="@dimen/widget_gap"
    android:layout_marginBottom="@dimen/widget_gap"
    android:background="@color/widget_border" />

  <include layout="@layout/widget_summary_cells" />

  <LinearLayout
    android:id="@+id/sum_form_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_gap"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/sum_form_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary"
      android:textAllCaps="true"
      android:letterSpacing="0.05" />

    <TextView
      android:id="@+id/sum_form_zone"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textStyle="bold"
      android:textColor="@color/widget_text_primary" />

    <TextView
      android:id="@+id/sum_form_span"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:gravity="end"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />
  </LinearLayout>

  <ImageView
    android:id="@+id/sum_form_zones"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="48dp"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/large_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="2"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <include layout="@layout/widget_refresh_control" />

    <ImageView
      android:id="@+id/large_record"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="14dp"
      android:scaleType="fitCenter"
      android:visibility="gone"
      android:src="@drawable/widget_record_glyph" />
  </LinearLayout>
</LinearLayout>
