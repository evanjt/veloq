<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sum_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/widget_padding"
  android:background="@drawable/widget_background">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/sum_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textColor="@color/widget_text_secondary"
        android:textAllCaps="true"
        android:letterSpacing="0.05" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
          android:id="@+id/sum_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="@dimen/widget_text_metric"
          android:textStyle="bold"
          android:textColor="@color/widget_text_primary" />

        <TextView
          android:id="@+id/sum_trend"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:textSize="@dimen/widget_text_label"
          android:textColor="@color/widget_trend_flat" />
      </LinearLayout>

      <TextView
        android:id="@+id/sum_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <ImageView
      android:id="@+id/sum_sparkline"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:scaleType="fitXY"
      android:contentDescription="@null" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="@dimen/widget_gap"
    android:layout_marginBottom="@dimen/widget_gap"
    android:background="@color/widget_border" />

  <include layout="@layout/widget_summary_cells" />

  <TextView
    android:id="@+id/sum_form_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_gap"
    android:maxLines="1"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary"
    android:textAllCaps="true"
    android:letterSpacing="0.05" />

  <ImageView
    android:id="@+id/sum_form_zones"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="48dp"
    android:scaleType="fitXY"
    android:contentDescription="@null" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/large_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <include layout="@layout/widget_refresh_control" />

    <ImageView
      android:id="@+id/large_record"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="14dp"
      android:scaleType="fitCenter"
      android:visibility="gone"
      android:src="@drawable/widget_record_glyph"
      android:contentDescription="@null" />
  </LinearLayout>
</LinearLayout>
