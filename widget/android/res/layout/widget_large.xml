<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/widget_padding"
  android:background="@drawable/widget_background">

  <include layout="@layout/widget_summary_head" />

  <!-- The chart runs the card's full width under the head, at the height it is drawn at. -->
  <ImageView
    android:id="@+id/sum_sparkline"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="4dp"
    android:scaleType="fitXY" />

  <include layout="@layout/widget_summary_chart_caption" />

  <TextView
    android:fontFamily="@font/widget_manrope"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="@dimen/widget_gap"
    android:layout_marginBottom="@dimen/widget_gap"
    android:background="@color/widget_border" />

  <include layout="@layout/widget_summary_cells" />

  <LinearLayout
    android:id="@+id/sum_form_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_gap"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/sum_form_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary"
      android:textAllCaps="true"
      android:letterSpacing="0.05" />

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/sum_form_zone"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textStyle="bold"
      android:textColor="@color/widget_text_primary" />

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/sum_form_span"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:gravity="end"
      android:maxLines="1"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />
  </LinearLayout>

  <!-- Drawn at the height the placement leaves it; where the host lays it out at another, the
       bitmap is scaled whole, so its axis labels keep their proportions. -->
  <ImageView
    android:id="@+id/sum_form_zones"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="48dp"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/large_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="2"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <include layout="@layout/widget_refresh_control" />

    <ImageView
      android:id="@+id/sum_record"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="14dp"
      android:scaleType="fitCenter"
      android:visibility="gone"
      android:src="@drawable/widget_record_glyph" />
  </LinearLayout>
</LinearLayout>
