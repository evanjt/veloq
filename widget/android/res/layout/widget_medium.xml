<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/widget_padding"
  android:paddingEnd="@dimen/widget_padding"
  android:paddingTop="@dimen/widget_gap"
  android:paddingBottom="@dimen/widget_gap"
  android:background="@drawable/widget_background">

  <include layout="@layout/widget_summary_head" />

  <!-- The chart runs the card's full width under the head and takes the height left, so it is the
       part that gives way on a short placement. -->
  <ImageView
    android:id="@+id/sum_sparkline"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="4dp"
    android:scaleType="fitXY" />

  <include layout="@layout/widget_summary_chart_caption" />

  <TextView
    android:fontFamily="@font/widget_manrope"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@color/widget_border" />

  <include layout="@layout/widget_summary_cells" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/med_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="2"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <include layout="@layout/widget_refresh_control" />

    <ImageView
      android:id="@+id/sum_record"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:padding="14dp"
      android:scaleType="fitCenter"
      android:visibility="gone"
      android:src="@drawable/widget_record_glyph" />
  </LinearLayout>
</LinearLayout>
