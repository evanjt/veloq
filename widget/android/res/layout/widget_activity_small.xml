<?xml version="1.0" encoding="utf-8"?>
<!-- Last activity, narrow: the comparison the session raised, its gap, every attempt as a dot, the
     section records and the date. A snapshot without the comparison shows the name and figures
     instead. The padding is the gap token all round because a 2x2 placement is barely taller than
     its lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/act_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="@dimen/widget_gap"
  android:background="@drawable/widget_background">

  <ImageView
    android:id="@+id/act_preview"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:visibility="gone"
    android:scaleType="fitCenter" />

  <!-- The row wraps its content, so the record dot follows a short name; a long name fills the
       width, and its weight then shrinks it to leave the dot inside the card. -->
  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/act_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_label"
      android:textStyle="bold"
      android:textColor="@color/widget_text_primary" />

    <ImageView
      android:id="@+id/act_pr"
      android:layout_width="6dp"
      android:layout_height="6dp"
      android:layout_marginStart="4dp"
      android:src="@drawable/widget_pr_dot"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/act_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="3"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />

  <TextView
    android:id="@+id/act_hero"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_metric_line"
    android:visibility="gone"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="@dimen/widget_text_floor"
    android:autoSizeMaxTextSize="@dimen/widget_text_metric"
    android:autoSizeStepGranularity="1sp"
    android:textSize="@dimen/widget_text_metric"
    android:textStyle="bold"
    android:textColor="@color/widget_text_primary" />

  <TextView
    android:id="@+id/act_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="2"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />

  <ImageView
    android:id="@+id/act_dots"
    android:layout_width="match_parent"
    android:layout_height="10dp"
    android:layout_marginTop="2dp"
    android:visibility="gone"
    android:scaleType="fitStart"
    android:importantForAccessibility="no" />

  <TextView
    android:id="@+id/act_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="2"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />

  <TextView
    android:id="@+id/act_prs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="2"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />

  <TextView
    android:id="@+id/act_date"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="2"
    android:ellipsize="end"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />

  <TextView
    android:id="@+id/act_demo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="1"
    android:textSize="@dimen/widget_text_caption"
    android:textColor="@color/widget_text_secondary" />
</LinearLayout>
