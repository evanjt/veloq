<?xml version="1.0" encoding="utf-8"?>
<!-- Last activity, wide: the route scaled to the left half; on the right the name, the comparison,
     every attempt as a dot and the section records. A taller placement also fills the load, the
     form before and after, and the date. The renderer hides what a size or a snapshot lacks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:paddingStart="@dimen/widget_padding"
  android:paddingEnd="@dimen/widget_padding"
  android:paddingTop="@dimen/widget_gap"
  android:paddingBottom="@dimen/widget_gap"
  android:background="@drawable/widget_background">

  <ImageView
    android:id="@+id/act_preview"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="@dimen/widget_gap"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <!-- The row wraps its content, so the record dot follows a short name; a long name fills the
         width, and its weight then shrinks it to leave the dot inside the card. -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <TextView
        android:id="@+id/act_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

      <ImageView
        android:id="@+id/act_pr"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/widget_pr_dot"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
      android:id="@+id/act_date"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <TextView
      android:id="@+id/act_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="3"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />

    <TextView
      android:id="@+id/act_hero"
      android:layout_width="match_parent"
      android:layout_height="@dimen/widget_metric_line"
      android:visibility="gone"
      android:maxLines="1"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="@dimen/widget_text_floor"
      android:autoSizeMaxTextSize="@dimen/widget_text_metric"
      android:autoSizeStepGranularity="1sp"
      android:textSize="@dimen/widget_text_metric"
      android:textStyle="bold"
      android:textColor="@color/widget_text_primary" />

    <TextView
      android:id="@+id/act_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_secondary" />

    <ImageView
      android:id="@+id/act_dots"
      android:layout_width="match_parent"
      android:layout_height="10dp"
      android:layout_marginTop="2dp"
      android:visibility="gone"
      android:scaleType="fitStart"
      android:importantForAccessibility="no" />

    <TextView
      android:id="@+id/act_sub"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_secondary" />

    <TextView
      android:id="@+id/act_prs"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_secondary" />

    <TextView
      android:id="@+id/act_load"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="2"
      android:ellipsize="end"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_primary" />

    <!-- The label takes its own line, since a translated one leaves the change no room beside it. -->
    <LinearLayout
      android:id="@+id/act_form"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:orientation="vertical">

      <TextView
        android:id="@+id/act_form_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textColor="@color/widget_text_secondary" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/act_form_before"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="@dimen/widget_text_label"
          android:textStyle="bold"
          android:textColor="@color/widget_text_primary" />

        <TextView
          android:id="@+id/act_form_arrow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:maxLines="1"
          android:textSize="@dimen/widget_text_label"
          android:textColor="@color/widget_text_secondary" />

        <TextView
          android:id="@+id/act_form_after"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:maxLines="1"
          android:textSize="@dimen/widget_text_label"
          android:textStyle="bold"
          android:textColor="@color/widget_text_primary" />
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/act_demo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:maxLines="1"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_secondary" />
  </LinearLayout>
</LinearLayout>
