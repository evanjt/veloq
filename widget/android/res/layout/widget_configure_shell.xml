<?xml version="1.0" encoding="utf-8"?>
<!-- The frame every widget picker shares: a toolbar naming the widget being set up, then the
     picker's own layout in the content frame. WidgetConfigureActivity pads it by the bar insets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_configure_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/widget_configure_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/widget_configure_toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize" />
  </com.google.android.material.appbar.AppBarLayout>

  <FrameLayout
    android:id="@+id/widget_configure_content"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
</LinearLayout>
