<?xml version="1.0" encoding="utf-8"?>
<!-- Insights widget: up to four rows, each a tone mark, a title and a subtitle; the renderer
     shows as many as the size allows. Drawn as authored, which is the gallery preview and the
     moment before the first update, it shows the widget's name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:clipToOutline="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/widget_padding"
  android:background="@drawable/widget_background">

  <LinearLayout
    android:id="@+id/ins_message"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/ins_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:text="@string/widget_insights_label"
      android:textSize="@dimen/widget_text_value"
      android:textStyle="bold"
      android:textColor="@color/widget_text_primary" />

    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/ins_empty_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:visibility="gone"
      android:textSize="@dimen/widget_text_label"
      android:textColor="@color/widget_text_secondary" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/ins_row0"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone">

    <ImageView
      android:id="@+id/ins_dot0"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="@dimen/widget_gap"
      android:src="@drawable/widget_tone_dot" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_title0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_subtitle0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/ins_row1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone">

    <ImageView
      android:id="@+id/ins_dot1"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="@dimen/widget_gap"
      android:src="@drawable/widget_tone_dot" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_title1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_subtitle1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/ins_row2"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone">

    <ImageView
      android:id="@+id/ins_dot2"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="@dimen/widget_gap"
      android:src="@drawable/widget_tone_dot" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_subtitle2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/ins_row3"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone">

    <ImageView
      android:id="@+id/ins_dot3"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="@dimen/widget_gap"
      android:src="@drawable/widget_tone_dot" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_title3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_label"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

      <TextView
        android:fontFamily="@font/widget_manrope"
        android:id="@+id/ins_subtitle3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/widget_text_caption"
        android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:fontFamily="@font/widget_manrope"
    android:id="@+id/ins_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:maxLines="1"
    android:textSize="@dimen/widget_text_label"
    android:textColor="@color/widget_primary" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
      android:fontFamily="@font/widget_manrope"
      android:id="@+id/ins_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="2"
      android:textSize="@dimen/widget_text_caption"
      android:textColor="@color/widget_text_secondary" />
    <include layout="@layout/widget_refresh_control" />
  </LinearLayout>
</LinearLayout>
