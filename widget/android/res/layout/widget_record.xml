<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/record_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:padding="@dimen/widget_record_padding"
  android:background="@drawable/widget_record_background">

  <ImageView
    android:layout_width="@dimen/widget_record_glyph"
    android:layout_height="@dimen/widget_record_glyph"
    android:src="@drawable/widget_record_roundel"
    android:importantForAccessibility="no" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_record_label_height"
    android:layout_marginTop="@dimen/widget_record_gap"
    android:text="@string/widget_record"
    android:textSize="@dimen/widget_record_text_max"
    android:textStyle="bold"
    android:gravity="center"
    android:maxLines="1"
    android:ellipsize="end"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="@dimen/widget_record_text_min"
    android:autoSizeMaxTextSize="@dimen/widget_record_text_max"
    android:autoSizeStepGranularity="1sp"
    android:textColor="@color/widget_record_foreground" />
</LinearLayout>
