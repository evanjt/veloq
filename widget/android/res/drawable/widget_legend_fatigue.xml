<?xml version="1.0" encoding="utf-8"?>
<!-- The fatigue line's legend mark: a short stroke dashed as the line is, by the same generated
     lengths the chart bitmap reads, in the line's colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
  <stroke
    android:width="1dp"
    android:color="@color/widget_chart_fatigue"
    android:dashWidth="@dimen/widget_chart_fatigue_dash_on"
    android:dashGap="@dimen/widget_chart_fatigue_dash_off" />
  <size android:width="12dp" android:height="6dp" />
</shape>
