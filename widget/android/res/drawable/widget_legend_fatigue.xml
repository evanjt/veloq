<?xml version="1.0" encoding="utf-8"?>
<!-- The fatigue line's legend mark: a short stroke dashed as the line is, in the line's colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
  <stroke
    android:width="1dp"
    android:color="@color/widget_chart_fatigue"
    android:dashWidth="3dp"
    android:dashGap="2dp" />
  <size android:width="12dp" android:height="6dp" />
</shape>
