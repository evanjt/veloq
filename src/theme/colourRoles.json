    "gold-50": "the lightest gold step, kept with its ramp",
    "scrim": "the ground behind a sheet, read when the overlay opacities fold into it",
    "text-tertiary": "the third text step, which no palette key has yet",
    "text-on-gold": "the ink on a gold fill, read when the badge inks fold into it",
    "card-edge": "the raised card's dark edge, read when surfaces draw a border in dark",
    "control-boundary": "the edge of an unchecked control, read when switchTrackOff and inputBoundary fold into it",
    "achievement-bg": "the record tint, read when the record chips fold into it",
    "achievement-on-bg": "the ink on the record tint, read with achievement-bg",
    "section-badge": "the section number disc in lists, read when sectionPalette folds into it",
    "section-badge-ink": "the ink on section-badge, read with it",
    "record": "the record button and Live Activity red, read when recording folds into it",
    "chart-crosshair": "the chart scrubber line, read when the chart crosshair takes a token",
    "data-*": "the sequential and diverging data ramps, read when gradientScale, strengthRamp and contributionRamp fold into them",
    "sport-*": "the sport families and their shades, read when activityTypeColors folds into them",
    "stream-*": "one colour per activity stream, read when chartStreamColors folds into them",
    "zone-*": "the zone ladder, read when zoneColors, the interval bands and the workout steps fold into it",
    "map-*": "the map's own paints and basemap, read when the map layers and styles take the map tokens"
  }
