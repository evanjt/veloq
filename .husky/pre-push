#!/bin/sh

# A personal routes.db was once committed and its history rewritten. Refuse
# to push while the blob is still reachable from any local ref.
if git rev-list --objects --all | grep -q '^1c8f0e9a567179c76ac0bae7b9dfeff563b0c8dc'; then
  echo "Refusing to push: the purged routes.db blob is still reachable locally."
  echo "Run: git rev-list --all --objects | grep routes.db"
  exit 1
fi

refs=$(cat)

# The last point before personal data is unrecoverable. Every path any pushed
# commit added counts, not only the tip's tree, because a file added and deleted
# again inside the range is still in the history being published.
zero=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha
do
  [ -n "$local_sha" ] && [ "$local_sha" != "$zero" ] || continue
  if [ "$remote_sha" = "$zero" ]; then
    ./scripts/check-no-private-data.sh --range "$local_sha" --not --remotes || exit 1
  else
    ./scripts/check-no-private-data.sh --range "$remote_sha..$local_sha" || exit 1
  fi
done <<EOF
$refs
EOF

# Check if we're pushing a tag (version release)
# Tags look like: refs/tags/v0.0.5
while read local_ref local_sha remote_ref remote_sha
do
  if echo "$local_ref" | grep -q "^refs/tags/"; then
    tag_name=$(echo "$local_ref" | sed 's|refs/tags/||')
    echo "Pushing tag: $tag_name"
    echo "Validating store metadata for release..."

    npx tsx scripts/validate-store-metadata.ts

    if [ $? -ne 0 ]; then
      echo ""
      echo "Store metadata validation failed!"
      echo "Please fix the issues above before pushing the release tag."
      exit 1
    fi
  fi
done <<EOF
$refs
EOF

exit 0
