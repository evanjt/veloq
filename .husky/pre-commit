#!/bin/sh
set -e

# First, because a hook running against the wrong index rewrites the commit
# rather than checking it. See scripts/check-commit-index.sh.
./scripts/check-commit-index.sh "$0"
# Before anything reads the index: in the main checkout it may hold a merge's
# tree while that merge's gates are still running.
./scripts/check-commit-lock.sh
./scripts/check-no-private-data.sh
./scripts/format-staged.sh

# The tree as it stands now, after the formatter has had its turn. A gate that
# shells out to git can be handed this repository's index and stage its own
# fixture over it, which check-commit-index.sh runs too early to see.
staged_tree=$(./scripts/check-staged-tree.sh record)

# A conflicted merge is concluded by `git commit`, and git runs this hook for
# it, not `pre-merge-commit`, so without this a resolved conflict landed with
# no merged-tree lint count and none of the suites the merge touched. After
# lint-staged, so the battery sees the tree being committed, and after the lock
# check, which only probes, so `merge-gates.sh` can take the lock itself. Its
# `check-merge-lint.sh` counts the merged tree, so the working-tree count below
# is dropped for this commit: that count is the one that failed merges on
# another session's unsaved warning.
lint_gate="npm run lint"
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  ./scripts/merge-gates.sh
  lint_gate="echo counted on the merged tree by merge-gates.sh"
fi

# Nothing below this line is git's business, and everything below it may shell
# out to git against a temporary directory. Git exports these to its hooks and
# they beat `cwd`, so a fixture's `git add -A` writes this repository's index.
# The two checks above need them and have already run; unsetting here closes
# the class rather than the callers that happen to exist today.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_CEILING_DIRECTORIES GIT_CONFIG

# The gates are independent and the wait is paid once, so they run together
# and every one of them is reported. The runner records each gate's exit code
# whatever the gate does: gates started from here inherit this file's `set -e`,
# and a failing gate that dies on its failing command records nothing, which
# leaves the hook reading none but zeros.
#
# rustfmt only pays for itself when Rust is staged, and it is the only local
# check on Rust formatting: cargo fmt runs in CI and nowhere else, so the Rust
# Lint job was going red on whitespace and staying red. `rusttests` is scoped
# the same way and for a related reason: `cargo check` of the library passes
# when the only caller of a deleted method is a test, and nothing else here
# builds the test tree, so a deletion broke every Rust integration suite on main
# for days. Measured with the fleet active: 1 m 10 s cold, 0.2 s warm.
#
# `VELOQ_SKIP_GATES=tsc git commit ...` drops one gate and keeps the rest. In a
# worktree `tsc` resolves `veloqrs` to the main checkout and reports errors that
# are not in the tree being committed, and the answer to that used to be
# `--no-verify`, which also skips the lint ratchet: two warnings landed over the
# ceiling that way and failed the next session's merge rather than the commit
# that made them. `VELOQ_SKIP_GATES=rusttests` is the same answer for a worktree
# without the tracematch submodule, where cargo cannot load the workspace: the
# gate names the clone recipe, and the merge battery builds the test tree
# again. `lint` cannot be skipped, because it holds the tree at zero warnings.
#
# Two of the gates are scoped to the commit rather than the tree, because the
# whole-tree form of each was the hook's entire wall clock. Measured on a quiet
# machine: the full suite 44.3 s against 0.8 s for the tests the change reaches,
# and `format:check` 7.2 s globbing `src/` against the staged paths read out of
# the index. The gates run together, so the suite was the hook and the other
# four finished inside it.
#
# The guards are scoped by kind. A commit runs the correctness set, the guards
# whose violation is a broken build, a wrong number or a crash, and the style
# and worktree sets run at the merge and in CI. All of them run in one process
# at once (scripts/run-guards.mjs): 3.7 s for the lot, where one `npm run` each,
# one after another, took 22 s.
#
# Neither scoped gate is the only copy. The full suite runs in CI on every pull request, a
# merge runs the suites it touched through check-merge-tests.sh, and the same
# staged-path format check is what the merge hook uses. What is lost is a test
# that breaks for a reason `--onlyChanged` cannot trace through the import
# graph, and that is CI's to catch.
gates_rc=0
./scripts/run-gates.sh \
  "audit:./scripts/check-merge-format.sh && node scripts/run-guards.mjs --set commit" \
  "tsc:npx tsc --noEmit" \
  "lint:$lint_gate" \
  "test:npm run test:changed" \
  "rustfmt:npm run lint:rust-fmt" \
  "rusttests:npm run lint:rust-tests" || gates_rc=$?

./scripts/check-staged-tree.sh verify "$staged_tree"

exit $gates_rc
