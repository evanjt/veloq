#!/bin/sh

# git runs `pre-merge-commit` only for a merge that creates a commit. A branch
# that merged the integration branch into itself first, which is how a branch
# stays current, merges back as a fast-forward and git runs nothing at all: not
# `pre-commit`, not `pre-merge-commit`, not `pre-push`, since nothing here is
# pushed. `scripts/land-branch.sh` gates its candidate before it fast-forwards,
# so a landing is covered. A plain fast-forward made by hand is not, and this
# runs after the ref has moved, so it cannot refuse. Saying so is the whole job.
#
# The battery does not run here. It used to, and a failure reported after the
# move could only ask for a revert, while the shared checkout's index and disk
# put other sessions' files in front of the gates.

# Moved onto the candidate `land-branch.sh` gated, which it names.
if [ -n "${VELOQ_LANDING_GATED:-}" ] &&
  [ "$(git rev-parse HEAD 2>/dev/null)" = "$VELOQ_LANDING_GATED" ]; then
  exit 0
fi

# Git writes the reflog before running this and it says which of the two
# happened. Stay quiet only on the case that was gated, a merge that made a
# commit, so an unreadable reflog warns rather than quietly passing.
case "$(git reflog -1 --format=%gs HEAD 2>/dev/null)" in
  *"Merge made by"*) exit 0 ;;
esac

base=$(git rev-parse -q --verify --short ORIG_HEAD 2>/dev/null ||
  git rev-parse -q --verify --short 'HEAD@{1}' 2>/dev/null || true)
echo "post-merge: warning: that merge was a fast-forward, so no gate ran before it." >&2
echo "post-merge: land with scripts/land-branch.sh <branch>, which gates the candidate first." >&2
if [ -n "$base" ]; then
  echo "post-merge: to judge what this move landed: VELOQ_MERGE_BASE=$base ./scripts/merge-gates.sh" >&2
fi
exit 0
