#!/bin/sh
set -e

# git runs pre-commit for a commit and this for a merge that does not
# conflict, so a merge skipped every gate the hook holds. The ratchet went
# over its ceiling twice in one evening that way, B187 and B190, both found by
# hand afterwards.
#
# Not the full pre-commit battery: a merge has already had its branch gated,
# and two minutes on every merge would be paid to re-run what the branch ran.
# The ceiling is the one thing a merge can break that neither side did, since
# it is a whole-tree total and each branch only ever counted its own files.
./scripts/check-commit-index.sh "$0"
npm run lint
