# Native library binaries (built from source by the stated toolchain)
modules/veloqrs/android/src/main/jniLibs/
modules/veloqrs/build/
modules/veloqrs/ios/Frameworks/

# Generated files. The rule, and scripts/lint-generated-files.mjs holds the
# tree to it: a generated module is committed when its generator needs a
# toolchain or a network that CI, or a fresh clone, does not have. So a clone
# builds with Node, Rust with cargo-ndk, a JDK and the npm, crates.io and
# Maven registries, and nothing else.
#
# Tracked under that rule, and regenerated by npm run ffi:generate
# after a Rust FFI change:
#   modules/veloqrs/src/generated/   TypeScript bindings
#   modules/veloqrs/cpp/generated/   C++ bindings
#
# Tracked and not regenerated: the turbo-module wrappers
# modules/veloqrs/cpp/veloqrs.h and cpp/veloqrs.cpp. They began as
# uniffi-bindgen-react-native output, no script writes them now, and
# modules/veloqrs/scripts/fix-generated.sh patches veloqrs.cpp. They are
# maintained by hand.
#
# Ignored under the same rule: output the machine that builds makes for itself,
# which is platform-specific and belongs in no clone.
modules/veloqrs/android/src/main/java/uniffi/
modules/veloqrs/ios/Generated/
modules/veloqrs/ios/cpp/
modules/veloqrs/ios/BasemapAssets/

# NOTE: These files ARE committed (hand-maintained or project-specific):
# - modules/veloqrs/cpp/veloqrs.cpp, veloqrs.h (turbo-module wrappers, see above)
# - modules/veloqrs/android/CMakeLists.txt, build.gradle
# - modules/veloqrs/android/src/main/java/com/veloq/*.kt
# - modules/veloqrs/android/cpp-adapter.cpp
# - modules/veloqrs/ios/*.h, *.mm, *.podspec
# - modules/veloqrs/src/index.ts, NativeVeloqrs.ts

# Native build caches, for every local module
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/

# Temporary build outputs
/tmp/
*.so
*.dylib

# Keystores and signing
*.keystore
android/keystore.properties
!android/app/debug.keystore
coverage/
*.log

# Fastlane gems
config/fastlane/vendor/bundle

# E2E test artifacts
artifacts/
screenshots/
*.png
!docs/badges/google-play.png 

# Worktrees
.worktrees/
.claude
*.md

# Private device databases and exports. Real training data never enters the repo.
modules/veloqrs/rust/veloqrs/tests/fixtures/private/
*.veloqdb
*.db
.eslintcache

# Jest transform caches and haste maps. Not in the system temp directory,
# which is a tmpfs here, so the caches would be resident memory.
.jest-cache/

# Copied from widget/ios by src/plugins/with-ios-widget.js so the app process and the
# widget extension compile one Live Activity contract. Tracked in widget/ios only.
modules/veloq-live-activity/ios/RecordingActivity*.swift

# Maestro JUnit reports, written by a run and never read back.
maestro-*-retest.xml
!modules/veloqrs/assets/basemap/**/*.png
!modules/veloqrs/rust/veloqrs/floor/**/*.png
.tsbuild/
