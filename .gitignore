modules/veloq-recording-notification/android/.gradle/
modules/veloq-recording-notification/android/.cxx/

# Private device databases and exports. Real training data never enters the repo.
modules/veloqrs/rust/veloqrs/tests/fixtures/private/
*.veloqdb
*.db
.eslintcache

# Jest transform caches and haste maps. Not in the system temp directory,
# which is a tmpfs here, so the caches would be resident memory (B329).
.jest-cache/

# Copied from widget/ios by src/plugins/with-ios-widget.js so the app process and the
# widget extension compile one Live Activity contract. Tracked in widget/ios only.
modules/veloq-live-activity/ios/RecordingActivity*.swift

# Maestro JUnit reports, written by a run and never read back.
maestro-*-retest.xml
