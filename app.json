{
  "expo": {
    "name": "Veloq",
    "slug": "veloq",
    "version": "0.4.0",
    "scheme": "veloq",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": {
        "light": "./src/assets/icon.png",
        "dark": "./src/assets/icon-dark.png",
        "tinted": "./src/assets/icon-tinted.png"
      },
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.veloq.app",
      "buildNumber": "29",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en-AU",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "$(PRODUCT_BUNDLE_IDENTIFIER).widget-refresh"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appStoreUrl": "https://apps.apple.com/us/app/veloq/id6757836732"
    },
    "android": {
      "package": "com.veloq.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.veloq.app",
      "versionCode": 29,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "monochromeImage": "./src/assets/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      "./src/plugins/with-gradle-repositories",
      "./src/plugins/with-release-signing",
      "./src/plugins/with-packaging-options",
      "./src/plugins/with-r8-config",
      "./src/plugins/with-android-backup",
      "./src/plugins/with-android-bluetooth",
      "./src/plugins/with-plain-lan-transport",
      "./src/plugins/with-android-new-intent",
      "./src/plugins/with-android-restricted-resizability",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerIdentifier": "iCloud.com.veloq.app"
        }
      ],
      "./src/plugins/with-app-groups",
      "./src/plugins/with-android-widget",
      "./src/plugins/with-ios-widget",
      "./src/plugins/with-ios-push-extension",
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-localization",
      "./src/plugins/with-android-locale-config",
      [
      "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./src/assets/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "react-native-iap",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {},
          "ios": {
            "deploymentTarget": "16.4",
            "ccacheEnabled": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "modes": [
            "central"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f8cfc9cb-dda9-4d0a-a061-e2f01fb42c2f"
      }
    }
  }
}
