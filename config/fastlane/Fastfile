default_platform(:android)

# Promotions move an existing release between tracks; every upload must be
# off or supply hunts for release notes with no version code and aborts.
PROMOTE_SKIPS = {
  skip_upload_aab: true,
  skip_upload_apk: true,
  skip_upload_metadata: true,
  skip_upload_changelogs: true,
  skip_upload_images: true,
  skip_upload_screenshots: true,
}.freeze

# ==============================
# Android Lanes
# ==============================

platform :android do
  desc "Deploy AAB to Google Play Store"
  lane :deploy do |options|
    track = options[:track] || "internal"
    aab_path = options[:aab]
    mapping_path = options[:mapping]

    UI.user_error!("No AAB file specified. Use aab:<path>") unless aab_path
    UI.user_error!("AAB file not found: #{aab_path}") unless File.exist?(aab_path)

    # Auto-detect mapping file if not specified (R8 generates this during release builds)
    if mapping_path.nil?
      project_root = File.expand_path("../..", __dir__)
      default_mapping = File.join(project_root, "android/app/build/outputs/mapping/release/mapping.txt")
      mapping_path = default_mapping if File.exist?(default_mapping)
    end

    UI.message("Uploading #{aab_path} to #{track} track...")
    UI.message("Mapping file: #{mapping_path || 'none'}") if mapping_path

    supply(
      track: track,
      aab: aab_path,
      mapping: mapping_path,
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "completed"
    )
  end

  desc "Promote from internal to beta track"
  lane :promote_to_beta do
    supply(
      track: "internal",
      track_promote_to: "beta",
      **PROMOTE_SKIPS
    )
  end

  desc "Promote from beta to production (10% rollout)"
  lane :promote_to_production do
    supply(
      track: "beta",
      track_promote_to: "production",
      rollout: "0.1",
      **PROMOTE_SKIPS
    )
  end

  desc "Upload metadata only to Play Store (no binary)"
  lane :metadata do
    supply(
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload store images only: feature graphic, icon and phone screenshots"
  lane :screenshots do |options|
    # supply resolves a single track release even for a listing-only push, so
    # anchor to a version code when a track holds more than one.
    params = {
      metadata_path: File.expand_path("metadata/android", __dir__),
      track: options[:track] || "internal",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    }
    params[:version_code] = options[:version_code].to_i if options[:version_code]
    supply(params)
  end

  desc "Print what Play currently holds: every track, release status and version code"
  lane :play_state do
    require "supply"
    require "supply/client"
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      package_name: "com.veloq.app",
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: Supply.config[:package_name])
    UI.message("Bundles in library: #{client.aab_version_codes.inspect}")
    client.tracks.each do |track|
      releases = track.releases.to_a
      UI.message("#{track.track}: (no releases)") if releases.empty?
      releases.each do |rel|
        UI.message("#{track.track}: status=#{rel.status} codes=#{(rel.version_codes || []).join(',')} name=#{rel.name.inspect}")
      end
    end
    # Live listing images against the repo, so a stale upload is obvious. Play
    # reports a sha256 of the bytes it stored, which matches the file we sent.
    require "digest"
    Dir[File.expand_path("metadata/android/*/", __dir__)].sort.each do |dir|
      lang = File.basename(dir)
      live = client.fetch_images(image_type: "phoneScreenshots", language: lang).to_a
      local = Dir[File.join(dir, "images", "phoneScreenshots", "*.{png,jpg}")].sort
      local_hashes = local.map { |f| Digest::SHA256.file(f).hexdigest }
      matched = live.count { |img| local_hashes.include?(img.sha256) }
      state = matched == local.size && live.size == local.size ? "in sync" : "STALE"
      UI.message("#{lang} phoneScreenshots: live=#{live.size} repo=#{local.size} matching=#{matched} #{state}")
    end
    client.abort_current_edit
  end
end

# ==============================
# iOS Lanes (requires Apple Developer account)
# ==============================

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :certificates do
    match(type: "appstore", readonly: true)
  end

  desc "Build release IPA"
  lane :build_release do
    certificates

    # Get absolute paths (fastlane doesn't handle ../ well in some actions)
    project_root = File.expand_path("../..", __dir__)
    xcodeproj = File.join(project_root, "ios", "veloq.xcodeproj")
    xcworkspace = File.join(project_root, "ios", "veloq.xcworkspace")

    # Set team ID and code signing settings in Xcode project
    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["FASTLANE_TEAM_ID"],
      profile_name: "match AppStore com.veloq.app",
      code_sign_identity: "iPhone Distribution"
    )

    # Ensure artifacts directory exists for build logs
    FileUtils.mkdir_p("artifacts")

    build_app(
      workspace: xcworkspace,
      scheme: "Veloq",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "artifacts",
      output_name: "veloq.ipa",
      clean: false,  # Don't clean - faster and avoids cache issues
      include_bitcode: false,
      buildlog_path: "artifacts",  # Save full xcodebuild log for debugging
      # NOTE: Don't use --keychain with ~ path - tilde doesn't expand in xcargs.
      # Match already configured certs in login.keychain, codesign will find them.
      # --timestamp=none prevents codesign from contacting Apple's timestamp servers
      # which can hang indefinitely in CI environments (especially with large XCFrameworks like MapLibre)
      xcargs: "-verbose OTHER_CODE_SIGN_FLAGS='--timestamp=none'"
    )
  end

  desc "Upload to TestFlight (internal track)"
  lane :beta do |options|
    ipa_path = options[:ipa] || "artifacts/veloq.ipa"

    UI.user_error!("No IPA file specified. Use ipa:<path>") unless ipa_path
    UI.user_error!("IPA file not found: #{ipa_path}") unless File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit to App Store Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      metadata_path: File.expand_path("metadata/ios", __dir__)
    )
  end

  desc "Upload metadata only to App Store Connect (no binary, no review submission)"
  lane :metadata do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver_params = {
      api_key: api_key,
      submit_for_review: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      metadata_path: File.expand_path("metadata/ios", __dir__)
    }

    if options[:app_version]
      deliver_params[:app_version] = options[:app_version]
    end

    deliver(deliver_params)
  end

  desc "Upload App Store screenshots only (no binary, no metadata, no review submission)"
  lane :screenshots do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver_params = {
      api_key: api_key,
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      # sync_screenshots diffs against what ASC already holds and skips
      # unchanged files; overwrite replaces the live set with the repo's.
      sync_screenshots: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    }

    if options[:app_version]
      deliver_params[:app_version] = options[:app_version]
    end

    deliver(deliver_params)
  end
end
