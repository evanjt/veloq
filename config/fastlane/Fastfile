require "tmpdir"

default_platform(:android)

PROJECT_ROOT = File.expand_path("../..", __dir__)
STORE_RELEASE = File.join(PROJECT_ROOT, "scripts", "store-release.ts")

# A lane option passed on the command line arrives as a string.
def flag(value)
  value == true || value.to_s == "true"
end

# The node that runs the store scripts, with the notice node 24 prints for a
# TypeScript file in a package that names no module type left out.
def store_release(*args)
  sh("node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", STORE_RELEASE, *args)
end

# The phone screenshots a locale's listing installs from, the set
# `npm run store:screenshots` writes into the locale's fastlane tree.
def repo_phone_screenshots(lang)
  Dir[File.expand_path("metadata/android/#{lang}/images/phoneScreenshots/*.{png,jpg,jpeg}", __dir__)].sort
end

# ==============================
# Android Lanes
# ==============================

platform :android do
  # metadata_path is the tree scripts/store-release.ts staged, which holds every
  # locale's changelog and only the texts, images and screenshot sets that
  # changed since the previous release; metadata, images and screenshots say
  # which kinds it holds. Without a staged tree the lane sends no listing but
  # the changelogs. The release goes to the track completed and is staged on
  # production as a draft: the rollout is the rollout lane.
  desc "Upload an AAB to a track, the staged listing changes with it, and a production draft"
  lane :deploy do |options|
    track = options[:track] || "internal"
    aab_path = options[:aab]
    mapping_path = options[:mapping]
    version_code = options[:version_code]

    UI.user_error!("No AAB file specified. Use aab:<path>") unless aab_path
    UI.user_error!("AAB file not found: #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("No version code specified. Use version_code:<n>") unless version_code

    # Auto-detect mapping file if not specified (R8 generates this during release builds)
    if mapping_path.nil?
      default_mapping = File.join(PROJECT_ROOT, "android/app/build/outputs/mapping/release/mapping.txt")
      mapping_path = default_mapping if File.exist?(default_mapping)
    end

    UI.message("Uploading #{aab_path} to #{track} track...")
    UI.message("Mapping file: #{mapping_path || 'none'}") if mapping_path

    supply(
      track: track,
      aab: aab_path,
      mapping: mapping_path,
      metadata_path: options[:metadata_path] || File.expand_path("metadata/android", __dir__),
      skip_upload_metadata: !flag(options[:metadata]),
      skip_upload_images: !flag(options[:images]),
      skip_upload_screenshots: !flag(options[:screenshots]),
      sync_image_upload: true,
      release_status: "completed"
    )

    next if track == "production"

    supply(
      track: track,
      track_promote_to: "production",
      track_promote_release_status: "draft",
      version_code: version_code.to_i,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote from internal to beta track"
  lane :promote_to_beta do
    supply(
      track: "internal",
      track_promote_to: "beta",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote from beta to production (10% rollout)"
  lane :promote_to_production do
    supply(
      track: "beta",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "0.1"
    )
  end

  desc "Release the production draft a tag staged to a fraction of users (default 10%)"
  lane :rollout do |options|
    supply(
      track: "production",
      version_code: options[:version_code]&.to_i,
      rollout: (options[:fraction] || "0.1").to_s,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload metadata only to Play Store (no binary)"
  lane :metadata do
    supply(
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Print, per locale, whether the live Play listing texts match the repository"
  lane :drift do
    require "supply"
    require "supply/setup"
    live = File.join(Dir.tmpdir, "store-live", "android")
    FileUtils.rm_rf(live)
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      { metadata_path: live, track: "production" }
    )
    Supply::Setup.new.perform_download
    store_release("drift", "--platform", "android", "--live", live)
  end

  desc "Print what Play holds: every track's releases and version codes, and per locale whether the live phone screenshots match the repository"
  lane :play_state do
    require "digest"
    require "supply"
    require "supply/client"
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      package_name: "com.veloq.app"
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: Supply.config[:package_name])
    UI.message("Bundles in library: #{client.aab_version_codes.inspect}")
    client.tracks.each do |track|
      releases = track.releases.to_a
      UI.message("#{track.track}: (no releases)") if releases.empty?
      releases.each do |rel|
        UI.message("#{track.track}: status=#{rel.status} codes=#{(rel.version_codes || []).join(',')} name=#{rel.name.inspect}")
      end
    end
    # Play reports a sha256 of the bytes it stored, which matches the file sent.
    Dir[File.expand_path("metadata/android/*/", __dir__)].sort.each do |dir|
      lang = File.basename(dir)
      live = client.fetch_images(image_type: "phoneScreenshots", language: lang).to_a
      local_hashes = repo_phone_screenshots(lang).map { |f| Digest::SHA256.file(f).hexdigest }
      matched = live.count { |img| local_hashes.include?(img.sha256) }
      state = matched == local_hashes.size && live.size == local_hashes.size ? "in sync" : "differs"
      UI.message("#{lang} phoneScreenshots: live=#{live.size} repo=#{local_hashes.size} matching=#{matched} #{state}")
    end
    client.abort_current_edit
  end
end

# ==============================
# iOS Lanes (requires Apple Developer account)
# ==============================

XCODEPROJ = File.join(PROJECT_ROOT, "ios", "veloq.xcodeproj")
XCWORKSPACE = File.join(PROJECT_ROOT, "ios", "veloq.xcworkspace")

# Every target App Store signing covers: name, bundle id and entitlements file,
# read from the prebuilt project so a new extension is signed without an edit here.
def signed_targets
  require "xcodeproj"
  signed_types = [
    Xcodeproj::Constants::PRODUCT_TYPE_UTI[:application],
    Xcodeproj::Constants::PRODUCT_TYPE_UTI[:app_extension]
  ]
  Xcodeproj::Project.open(XCODEPROJ).native_targets
    .select { |t| signed_types.include?(t.product_type) }
    .map do |t|
      settings = t.build_configurations.find { |c| c.name == "Release" }.build_settings
      {
        name: t.name,
        bundle_id: settings["PRODUCT_BUNDLE_IDENTIFIER"].to_s.delete('"'),
        entitlements: settings["CODE_SIGN_ENTITLEMENTS"]&.delete('"')
      }
    end
end

def profile_name(bundle_id)
  "match AppStore #{bundle_id}"
end

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :certificates do
    match(type: "appstore", readonly: true, app_identifier: signed_targets.map { |t| t[:bundle_id] })
  end

  desc "Check each App Store profile carries its target's bundle id and entitlements"
  lane :check_signing do
    require "plist"
    certificates
    problems = signed_targets.flat_map do |target|
      id = target[:bundle_id]
      profile = FastlaneCore::ProvisioningProfile.parse(ENV["sigh_#{id}_appstore_profile-path"])
      granted = profile["Entitlements"]
      found = []
      unless granted["application-identifier"].to_s.end_with?(".#{id}")
        found << "#{target[:name]}: profile app id #{granted['application-identifier']} is not #{id}"
      end
      wanted = target[:entitlements] ? Plist.parse_xml(File.join(PROJECT_ROOT, "ios", target[:entitlements])) || {} : {}
      wanted.each_key do |key|
        found << "#{target[:name]}: profile lacks #{key}" unless granted.key?(key)
      end
      key = "com.apple.security.application-groups"
      (Array(wanted[key]) - Array(granted[key])).each do |group|
        found << "#{target[:name]}: profile lacks app group #{group}"
      end
      found
    end
    UI.user_error!("App Store signing would fail:\n#{problems.join("\n")}") unless problems.empty?
    UI.success("Profiles match #{signed_targets.map { |t| t[:name] }.join(', ')}")
  end

  desc "Build release IPA"
  lane :build_release do
    check_signing

    signed_targets.each do |target|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: XCODEPROJ,
        team_id: ENV["FASTLANE_TEAM_ID"],
        targets: [target[:name]],
        profile_name: profile_name(target[:bundle_id]),
        code_sign_identity: "iPhone Distribution"
      )
    end

    # Ensure artifacts directory exists for build logs
    FileUtils.mkdir_p("artifacts")

    build_app(
      workspace: XCWORKSPACE,
      scheme: "Veloq",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "artifacts",
      output_name: "veloq.ipa",
      clean: false,  # Don't clean - faster and avoids cache issues
      include_bitcode: false,
      buildlog_path: "artifacts",  # Save full xcodebuild log for debugging
      # NOTE: Don't use --keychain with ~ path - tilde doesn't expand in xcargs.
      # Match already configured certs in login.keychain, codesign will find them.
      # --timestamp=none prevents codesign from contacting Apple's timestamp servers
      # which can hang indefinitely in CI environments (especially with large XCFrameworks like MapLibre)
      xcargs: "-verbose OTHER_CODE_SIGN_FLAGS='--timestamp=none'"
    )
  end

  desc "Upload to TestFlight (internal track)"
  lane :beta do |options|
    ipa_path = options[:ipa] || "artifacts/veloq.ipa"

    UI.user_error!("No IPA file specified. Use ipa:<path>") unless ipa_path
    UI.user_error!("IPA file not found: #{ipa_path}") unless File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  # The listing went up with the tag, so submission sends none of it again.
  desc "Submit the version a tag prepared to App Store Review (phased release over 7 days)"
  lane :release do |options|
    UI.user_error!("No version specified. Use app_version:<x.y.z>") unless options[:app_version]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      app_version: options[:app_version],
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  # Creates the App Store version for app_version when none is editable, so the
  # version is in Prepare for Submission after a tag. metadata_path and
  # screenshots_path are the trees scripts/store-release.ts staged: every
  # locale's release notes and only the texts and screenshot sets that changed.
  # overwrite_screenshots replaces the live sets of the locales staged and
  # leaves every other locale's alone, and screenshots says whether any is.
  desc "Create the App Store version and upload the staged listing changes (no binary, no review submission)"
  lane :metadata do |options|
    UI.user_error!("No version specified. Use app_version:<x.y.z>") unless options[:app_version]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    screenshots = flag(options[:screenshots])
    deliver(
      api_key: api_key,
      app_version: options[:app_version],
      submit_for_review: false,
      skip_binary_upload: true,
      skip_screenshots: !screenshots,
      overwrite_screenshots: screenshots,
      screenshots_path: options[:screenshots_path],
      force: true,
      run_precheck_before_submit: false,
      metadata_path: options[:metadata_path] || File.expand_path("metadata/ios", __dir__)
    )
  end

  desc "Print, per locale, whether the live App Store listing texts match the repository"
  lane :drift do
    require "deliver"
    require "deliver/setup"
    live = File.join(Dir.tmpdir, "store-live", "ios")
    FileUtils.rm_rf(live)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )
    options = FastlaneCore::Configuration.create(
      Deliver::Options.available_options,
      { api_key: api_key, metadata_path: live, skip_screenshots: true }
    )
    Deliver::Runner.new(options)
    app = Deliver.cache[:app]
    version = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS) ||
              app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    Deliver::Setup.new.generate_metadata_files(app, version, live, options)
    store_release("drift", "--platform", "ios", "--live", live)
  end
end
