{
  "name": "veloq",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/evanjt/veloq"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "android": "./scripts/with-android-build-lock.sh sh -c 'npx expo run:android'",
    "android:prod": "./scripts/with-android-build-lock.sh sh -c 'APP_VARIANT=production npx expo run:android --variant release'",
    "bundle:android": "node scripts/bundle-android.mjs",
    "android:debug": "./scripts/with-android-build-lock.sh sh -c 'npm run bundle:android && cd android && ./gradlew assembleDebug' && npm run check:native-records",
    "install:android": "./scripts/install-apk.sh",
    "ios": "npx expo run:ios",
    "ios:prod": "APP_VARIANT=production npx expo run:ios --configuration Release",
    "sync:live-activity": "node scripts/sync-live-activity-sources.js",
    "test:android": "./scripts/with-android-build-lock.sh ./scripts/with-device-lock.sh sh -c 'cd android && ./gradlew :veloqrs:connectedDebugAndroidTest -PreactNativeArchitectures=arm64-v8a'",
    "test:rust": "cd modules/veloqrs/rust && cargo test -p veloqrs",
    "test:rust:synthetic": "cd modules/veloqrs/rust && cargo test -p veloqrs --features synthetic",
    "clean:rust": "npm run clean --prefix modules/veloqrs",
    "clean:rust:full": "npm run clean:full --prefix modules/veloqrs",
    "rebuild:android": "./scripts/with-android-build-lock.sh sh -c 'npm run clean:rust && npx expo run:android'",
    "rebuild:android:prod": "./scripts/with-android-build-lock.sh sh -c 'npm run clean:rust && APP_VARIANT=production npx expo run:android --variant release'",
    "rebuild:ios": "npm run clean:rust && npx expo run:ios",
    "rebuild:ios:prod": "npm run clean:rust && APP_VARIANT=production npx expo run:ios --configuration Release",
    "build:info": "cat modules/veloqrs/android/src/main/jniLibs/BUILD_INFO 2>/dev/null || echo 'No build info found'",
    "web": "npx expo start --web",
    "test": "jest --config config/jest.config.js --selectProjects app",
    "test:tooling": "jest --config config/jest.config.js --selectProjects tooling",
    "test:changed": "jest --config config/jest.config.js --onlyChanged",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --selectProjects app --coverage",
    "test:perf": "VELOQ_PERF=1 jest --config config/jest.config.js --testPathPattern=perf.test --verbose",
    "test:perf:ci": "VELOQ_PERF=1 jest --config config/jest.config.js --testPathPattern=perf.test --json --outputFile=perf-results.json",
    "format": "prettier --config config/.prettierrc --ignore-path config/.prettierignore --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint . --no-warn-ignored --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format:check": "prettier --config config/.prettierrc --ignore-path config/.prettierignore --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "postinstall": "node scripts/patch-expo-signing.js && node scripts/patch-expo-location.js",
    "maestro:smoke": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier0 --no-ansi",
    "maestro:gate": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier0,tier1 --no-ansi",
    "maestro:test": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier0,tier1,tier2 --no-ansi",
    "maestro:stress": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier3 --no-ansi",
    "maestro:screenshots": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier4 --no-ansi",
    "maestro:full": "./scripts/with-maestro.sh test .maestro/ --include-tags=tier0,tier1,tier2,tier3 --no-ansi",
    "maestro:pack:auth": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-auth --no-ansi",
    "maestro:pack:nav": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-nav --no-ansi",
    "maestro:pack:home": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-home --no-ansi",
    "maestro:pack:activity": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-activity --no-ansi",
    "maestro:pack:map": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-map --no-ansi",
    "maestro:pack:fitness": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-fitness --no-ansi",
    "maestro:pack:training": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-training --no-ansi",
    "maestro:pack:routes": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-routes --no-ansi",
    "maestro:pack:settings": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-settings --no-ansi",
    "maestro:pack:data": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-data --no-ansi",
    "maestro:pack:stress": "./scripts/with-maestro.sh test .maestro/ --include-tags=pack-stress --no-ansi",
    "ffi:generate": "npm --prefix modules/veloqrs run generate",
    "config:unified": "npx tsx scripts/generate-unified-config.ts",
    "config:trend": "npx tsx scripts/generate-trend-table.ts",
    "config:trend:check": "npx tsx scripts/generate-trend-table.ts --check",
    "config:unified:check": "npx tsx scripts/generate-unified-config.ts --check",
    "config:sports": "npx tsx scripts/generate-sport-taxonomy.ts",
    "config:sports:check": "npx tsx scripts/generate-sport-taxonomy.ts --check",
    "ffi:test": "jest --config config/jest.config.js --testPathPattern=ffiBinding",
    "ffi:usage": "npx tsx scripts/ffi-usage-report.ts",
    "ffi:unused": "npx tsx scripts/ffi-usage-report.ts --unused",
    "ffi:reach": "npx tsx scripts/ffi-usage-report.ts --check",
    "lint:rust-fmt": "npx tsx scripts/check-rust-fmt.ts",
    "lint:rust-tests": "npx tsx scripts/check-rust-tests.ts",
    "ffi:orphans": "node scripts/engine-orphan-report.mjs",
    "gen:widget-theme": "npx tsx scripts/gen-widget-theme.ts",
    "check:widget-theme": "npx tsx scripts/gen-widget-theme.ts --check",
    "check:expo": "node scripts/check-expo-sdk.mjs",
    "check:android-prebuild": "node scripts/check-android-prebuild.mjs",
    "lint:detector-ordering": "node scripts/lint-detector-ordering.mjs",
    "lint:em-dashes": "node scripts/lint-em-dashes.mjs",
    "lint:comment-line-refs": "node scripts/lint-comment-line-refs.mjs",
    "lint:au-spelling": "node scripts/lint-au-spelling.mjs",
    "lint:generated-files": "node scripts/lint-generated-files.mjs",
    "lint:audit-ids": "node scripts/lint-audit-ids.mjs",
    "crash:guard": "node scripts/crash-guard-sweep.mjs",
    "lint:engine-bridge": "node scripts/engine-event-bridge-audit.mjs",
    "gen:muscle-polygons": "node scripts/generate-muscle-polygons.mjs",
    "lint:muscle-polygons": "node scripts/generate-muscle-polygons.mjs --check",
    "lint:reachability": "node scripts/reachability-audit.mjs",
    "lint:render-engine-reads": "node scripts/lint-render-engine-reads.mjs",
    "lint:feature-imports": "node scripts/lint-feature-imports.mjs",
    "lint:engine-surface": "node scripts/lint-engine-surface.mjs --engine-ceiling 110 --store-ceiling 20",
    "lint:module-link": "node scripts/lint-module-link.mjs",
    "modules:link": "node scripts/link-worktree-modules.mjs",
    "lint:worktree-config": "node scripts/lint-worktree-config.mjs",
    "lint:cargo-config-reach": "node scripts/lint-cargo-config-reach.mjs",
    "lint:submodule-pointer": "node scripts/lint-submodule-pointer.mjs",
    "lint:tracematch-lockfile": "node scripts/lint-tracematch-lockfile.mjs",
    "check:android-bundle": "node scripts/lint-android-bundle.mjs",
    "check:native-records": "node scripts/lint-native-record-shapes.mjs",
    "lint:window-dimensions": "node scripts/lint-window-dimensions.mjs",
    "lint:verdict-palette": "node scripts/lint-verdict-palette.mjs",
    "lint:mark-contrast": "node scripts/lint-mark-contrast.mjs",
    "coverage:rust": "node scripts/check-rust-coverage.mjs",
    "ffi:gate": "node scripts/ffi-timing-gate.mjs",
    "perf:coldstart": "node scripts/cold-start-scaling-harness.mjs",
    "audit": "npm run format:check && node scripts/run-guards.mjs --set all",
    "audit:guards": "node scripts/run-guards.mjs --set land",
    "doctor": "node scripts/run-guards.mjs --set environment",
    "lint:maestro-ids": "node scripts/lint-maestro-ids.mjs",
    "lint:press-feedback": "node scripts/lint-press-feedback.mjs",
    "lint:detect-recv": "node scripts/lint-detect-recv.mjs",
    "lint:engine-write-lock": "node scripts/lint-engine-write-lock.mjs",
    "lint:rgba": "node scripts/lint-rgba-literals.mjs",
    "lint:hand-rolled-buttons": "node scripts/lint-hand-rolled-buttons.mjs",
    "lint:decline-visible": "node scripts/lint-decline-visible.mjs",
    "lint:observer-vtable": "node scripts/lint-one-observer-vtable.mjs",
    "lint:foreign-converter": "node scripts/lint-foreign-converter-cursor.mjs",
    "lint:ffi-throw-type": "node scripts/lint-ffi-throw-type.mjs",
    "lint:ffi-bigint": "node scripts/lint-ffi-bigint.mjs",
    "lint:zero-warnings": "node scripts/lint-zero-warnings.mjs",
    "lint:trend-thresholds": "node scripts/lint-trend-thresholds.mjs",
    "lint:retired-names": "node scripts/lint-retired-names.mjs",
    "lint:jest-mocks": "node scripts/lint-jest-mock-partial.mjs",
    "ffi:areas": "npx tsx scripts/ffi-usage-report.ts --areas",
    "ffi:area-check": "npx tsx scripts/ffi-usage-report.ts --check-areas"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mapbox/polyline": "^1.2.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.12",
    "@ubjs/core": "0.31.0-5",
    "d3-shape": "^3.2.0",
    "expo": "^56",
    "expo-build-properties": "~56.0.16",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.15",
    "expo-network": "~56.0.4",
    "expo-notifications": "~56.0.15",
    "expo-router": "~58.0.13",
    "expo-screen-orientation": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.15",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.16",
    "expo-web-browser": "~56.0.5",
    "i18next": "^25.7.3",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-body-highlighter": "^3.1.4",
    "react-native-cloud-storage": "^3.0.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-iap": "^15.2.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "veloqrs": "./modules/veloqrs",
    "zod": "^4.3.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.8",
    "@expo/ngrok": "^4.1.3",
    "@react-native/assets-registry": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/d3-shape": "^3.1.8",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jest-expo": "~56.0.4",
    "prettier": "^3.4.2",
    "react-dom": "19.2.3",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "uniffi-bindgen-react-native": "^0.31.0-5"
  },
  "private": true,
  "overrides": {
    "expo-modules-core": "56.0.14",
    "js-yaml": "^4.3.0",
    "uuid": ">=11.1.1"
  }
}
