    "android:debug": "npm run lint:expo-location-altitude && node scripts/check-native-tree.mjs --installation && APP_VARIANT=dev ./scripts/with-android-build-lock.sh sh -c 'node scripts/prepare-native.mjs --platform android && node scripts/sync-android-widgets.mjs && node scripts/check-native-tree.mjs && npm run bundle:android && (cd android && ./gradlew assembleDebug) && node scripts/build-record.js write debug' && npm run check:native-records",
