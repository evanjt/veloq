    "install:ios": "./scripts/install-ios.sh",
    "ios": "node scripts/check-native-tree.mjs && ./scripts/run-ios.sh dev metro",
    "ios:record": "APP_VARIANT=dev node scripts/build-record.js write-ios Debug",
    "ios:standalone": "node scripts/check-native-tree.mjs && ./scripts/run-ios.sh dev standalone",
    "ios:prod": "node scripts/check-native-tree.mjs && ./scripts/run-ios.sh production standalone",
    "ios:gate": "./scripts/ios-gate.sh",
    "sync:live-activity": "node scripts/sync-live-activity-sources.js",
