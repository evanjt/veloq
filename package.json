    "test:widget-captures": "node scripts/check-native-tree.mjs --installation && ./scripts/with-android-build-lock.sh sh -c 'node scripts/prepare-native.mjs --platform android && node scripts/sync-android-widgets.mjs && node scripts/check-native-tree.mjs && cd android && ./gradlew :veloqrs:assembleDebugAndroidTest -PreactNativeArchitectures=arm64-v8a' && scripts/widget-captures-android.sh",
    "test:android:unit": "node scripts/check-native-tree.mjs --installation && ./scripts/with-android-build-lock.sh sh -c 'node scripts/prepare-native.mjs --platform android && node scripts/sync-android-widgets.mjs && node scripts/check-native-tree.mjs && cd android && ./gradlew :veloqrs:testDebugUnitTest :veloq-display:testDebugUnitTest :veloq-memory:testDebugUnitTest :veloq-recording-notification:testDebugUnitTest :veloq-backup-exclusion:testDebugUnitTest :veloq-widget:testDebugUnitTest -PreactNativeArchitectures=arm64-v8a'",
    "test:rust": "cd modules/veloqrs/rust && cargo test -p veloqrs",
    "test:rust:synthetic": "cd modules/veloqrs/rust && cargo test -p veloqrs --features synthetic",
    "test:widget-captures:ios": "scripts/widget-captures-ios.sh",
    "clean:rust": "npm run clean --prefix modules/veloqrs",
    "clean:rust:full": "npm run clean:full --prefix modules/veloqrs",
    "build:info": "cat modules/veloqrs/build/rust/*/*/manifest.json 2>/dev/null || echo 'No Rust build found'",
    "web": "npx expo start --web",
    "test": "jest --config config/jest.config.js --selectProjects app",
    "test:tooling": "jest --config config/jest.config.js --selectProjects tooling",
    "test:changed": "jest --config config/jest.config.js --onlyChanged",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --selectProjects app --coverage",
    "test:perf": "VELOQ_PERF=1 jest --config config/jest.config.js --testPathPattern=perf.test --verbose",
    "test:map-pages": "VELOQ_BROWSER=1 jest --config config/jest.config.js --selectProjects app --testPathPattern=browser.test",
    "test:perf:ci": "VELOQ_PERF=1 jest --config config/jest.config.js --testPathPattern=perf.test --json --outputFile=perf-results.json",
    "format": "prettier --config config/.prettierrc --ignore-path config/.prettierignore --write \"src/**/*.{ts,tsx}\" \"modules/veloqrs/src/**/*.ts\" \"!modules/veloqrs/src/generated/**/*.ts\" \"scripts/**/*.{mjs,cjs,js,ts}\"",
    "lint": "eslint . --no-warn-ignored --max-warnings 0 --cache --cache-strategy content --cache-location .eslintcache",
    "format:check": "prettier --config config/.prettierrc --ignore-path config/.prettierignore --check \"src/**/*.{ts,tsx}\" \"modules/veloqrs/src/**/*.ts\" \"!modules/veloqrs/src/generated/**/*.ts\" \"scripts/**/*.{mjs,cjs,js,ts}\"",
