diff --git a/src/features/maps/lib/stamp3d.ts b/src/features/maps/lib/stamp3d.ts
new file mode 100644
index 0000000000..3e360c40df
--- /dev/null
+++ b/src/features/maps/lib/stamp3d.ts
@@ -0,0 +1,6 @@
+// Temporary measurement stamp: prints through the runtime's native logging
+// hook, which a production bundle keeps while console output is dropped.
+export function stamp3d(message: string): void {
+  const hook = (globalThis as { nativeLoggingHook?: (m: string, level: number) => void }).nativeLoggingHook;
+  if (hook) hook(message, 1);
+}
